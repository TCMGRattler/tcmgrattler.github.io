{"version":"0.3.0","body":"interface RowObject {\n    [key: string]: string;\n}\n\ninterface TeamJson {\n    team: number;\n    bid: number;\n    owner: string;\n    member: string;\n    guest: string;\n    team_hcp: string;\n    member_hcp: string;\n    guest_hcp: string;\n}\n\ninterface AwardJson {\n    type: string;\n    day: string;\n    place: string;\n    amount: number;\n    winner: string;\n    owner: string;\n}\n\ninterface FlightJson {\n    flight: number;\n    total: number;\n    teams: TeamJson[];\n    flight_winners: AwardJson[];\n    day_money: AwardJson[];\n}\n\ninterface SummaryJson {\n    flightCount: number;\n    teamCount: number;\n    avgBid: number;\n    topFlight: number;\n    topFlightTotal: number;\n}\n\ninterface ShootoutJson {\n    bonusPool: number;\n    firstPlace: number;\n    secondPlace: number;\n    thirdPlace: number;\n}\n\ninterface SourceJson {\n    file: string;\n    generated: string;\n}\n\ninterface DataCheckJson {\n    flightCount: number;\n    teamCount: number;\n    sumOfFlightTotals: number;\n    sumOfTeamBids: number;\n}\n\ninterface DataJson {\n    summary: SummaryJson;\n    shootout: ShootoutJson;\n    lastUpdated: string;\n    flights: FlightJson[];\n    _source: SourceJson;\n    _dataCheck: DataCheckJson;\n}\n\nfunction main(workbook: ExcelScript.Workbook): string {\n\n    const teams: RowObject[] =\n        tableToObjects(\n            workbook,\n            \"tblTeams\"\n        );\n\n    const winners: RowObject[] =\n        tableToObjects(\n            workbook,\n            \"tblFlightWinners\"\n        );\n\n    const dayMoney: RowObject[] =\n        tableToObjects(\n            workbook,\n            \"tblDayMoney\"\n        );\n\n    const shootoutRows: RowObject[] =\n        tableToObjects(\n            workbook,\n            \"tblShootout\"\n        );\n\n    console.log(\n        \"Teams: \" + String(teams.length)\n    );\n\n    console.log(\n        \"Flight Winners: \" + String(winners.length)\n    );\n\n    console.log(\n        \"Day Money: \" + String(dayMoney.length)\n    );\n\n    console.log(\n        \"Shootout: \" + String(shootoutRows.length)\n    );\n\n    const flights: FlightJson[] =\n        buildFlights(\n            teams,\n            winners,\n            dayMoney\n        );\n\n    const summary: SummaryJson =\n        buildSummary(\n            teams,\n            flights\n        );\n\n    const shootout: ShootoutJson =\n        buildShootout(\n            shootoutRows\n        );\n\n    const dataCheck: DataCheckJson =\n        buildDataCheck(\n            flights\n        );\n\n    const data: DataJson = {\n\n        summary:\n            summary,\n\n        shootout:\n            shootout,\n\n        lastUpdated:\n            new Date()\n                .toISOString(),\n\n        flights:\n            flights,\n\n        _source: {\n\n            file:\n                \"2026 MG Master Spreadsheet v1.xlsx\",\n\n            generated:\n                new Date()\n                    .toISOString()\n\n        },\n\n        _dataCheck:\n            dataCheck\n\n    };\n\n    const jsonText: string =\n        JSON.stringify(\n            data,\n            null,\n            2\n        );\n    const jsText: string =\n        \"const DATA =\\n\" +\n        jsonText +\n        \";\";\n\n    writeJsToWorksheet(\n        workbook,\n        jsText\n    );\n\n  return jsText;\n\n}\n\nfunction tableToObjects(\n    workbook: ExcelScript.Workbook,\n    tableName: string\n): RowObject[] {\n\n    const tables: ExcelScript.Table[] =\n        workbook.getTables();\n\n    let targetTable:\n        ExcelScript.Table | undefined =\n        undefined;\n\n    for (\n        let i: number = 0;\n        i < tables.length;\n        i++\n    ) {\n\n        if (\n            tables[i].getName() === tableName\n        ) {\n\n            targetTable =\n                tables[i];\n\n        }\n\n    }\n\n    if (!targetTable) {\n\n        throw new Error(\n            \"Table not found: \" + tableName\n        );\n\n    }\n\n    const rows: string[][] =\n        targetTable\n            .getRange()\n            .getTexts();\n\n    if (\n        rows.length === 0\n    ) {\n\n        return [];\n\n    }\n\n    const headers: string[] =\n        rows[0];\n\n    const output: RowObject[] =\n        [];\n\n    for (\n        let r: number = 1;\n        r < rows.length;\n        r++\n    ) {\n\n        const obj: RowObject =\n            {};\n\n        let hasData: boolean =\n            false;\n\n        for (\n            let c: number = 0;\n            c < headers.length;\n            c++\n        ) {\n\n            const value: string =\n                String(\n                    rows[r][c] || \"\"\n                ).trim();\n\n            obj[\n                headers[c]\n            ] =\n                value;\n\n            if (\n                value !== \"\"\n            ) {\n\n                hasData =\n                    true;\n\n            }\n\n        }\n\n        if (\n            hasData\n        ) {\n\n            output.push(\n                obj\n            );\n\n        }\n\n    }\n\n    return output;\n\n}\n\nfunction buildFlights(\n    teams: RowObject[],\n    winners: RowObject[],\n    dayMoney: RowObject[]\n): FlightJson[] {\n\n    const uniqueFlights: {\n        [key: number]: boolean\n    } = {};\n\n    teams.forEach(\n        (\n            t: RowObject\n        ) => {\n\n            const flightNumber: number =\n                toNumber(\n                    getValue(\n                        t,\n                        \"Flight\"\n                    )\n                );\n\n            if (\n                flightNumber > 0\n            ) {\n\n                uniqueFlights[\n                    flightNumber\n                ] =\n                    true;\n\n            }\n\n        }\n    );\n\n    const flightNums: number[] =\n        Object.keys(\n            uniqueFlights\n        )\n            .map(\n                (\n                    key: string\n                ): number =>\n                    Number(key)\n            )\n            .sort(\n                (\n                    a: number,\n                    b: number\n                ): number =>\n                    a - b\n            );\n\n    const flights: FlightJson[] =\n        [];\n\n    flightNums.forEach(\n        (\n            f: number\n        ) => {\n\n            const flightTeamsRaw: RowObject[] =\n                teams.filter(\n                    (\n                        t: RowObject\n                    ): boolean =>\n                        toNumber(\n                            getValue(\n                                t,\n                                \"Flight\"\n                            )\n                        ) === f\n                );\n\n            const flightTeams: TeamJson[] =\n                flightTeamsRaw.map(\n                    (\n                        t: RowObject\n                    ): TeamJson => ({\n\n                        team:\n                            toNumber(\n                                getValue(\n                                    t,\n                                    \"Team\"\n                                )\n                            ),\n\n                        bid:\n                            toNumber(\n                                getValue(\n                                    t,\n                                    \"Bid\"\n                                )\n                            ),\n\n                        owner:\n                            getValue(\n                                t,\n                                \"Owner\"\n                            ),\n\n                        member:\n                            getValue(\n                                t,\n                                \"Member\"\n                            ),\n\n                        guest:\n                            getValue(\n                                t,\n                                \"Guest\"\n                            ),\n\n                        team_hcp:\n                            getValue(\n                                t,\n                                \"TeamHCP\"\n                            ),\n\n                        member_hcp:\n                            getValue(\n                                t,\n                                \"MemberHCP\"\n                            ),\n\n                        guest_hcp:\n                            getValue(\n                                t,\n                                \"GuestHCP\"\n                            )\n\n                    })\n                );\n\n            const flightTotal: number =\n                flightTeams.reduce(\n                    (\n                        sum: number,\n                        t: TeamJson\n                    ): number =>\n                        sum + t.bid,\n                    0\n                );\n\n            const flightWinners: AwardJson[] =\n                winners\n                    .filter(\n                        (\n                            w: RowObject\n                        ): boolean =>\n                            toNumber(\n                                getValue(\n                                    w,\n                                    \"Flight\"\n                                )\n                            ) === f\n                    )\n                    .map(\n                        (\n                            w: RowObject\n                        ): AwardJson => ({\n\n                            type:\n                                \"Flight Winner\",\n\n                            day:\n                                \"\",\n\n                            place:\n                                getValue(\n                                    w,\n                                    \"Place\"\n                                ),\n\n                            amount:\n                                toNumber(\n                                    getValue(\n                                        w,\n                                        \"Amount\"\n                                    )\n                                ),\n\n                            winner:\n                                getValue(\n                                    w,\n                                    \"Winner\"\n                                ),\n\n                            owner:\n                                getValue(\n                                    w,\n                                    \"Owner\"\n                                )\n\n                        })\n                    );\n\n            const dayMoneyRows: AwardJson[] =\n                dayMoney\n                    .filter(\n                        (\n                            d: RowObject\n                        ): boolean =>\n                            toNumber(\n                                getValue(\n                                    d,\n                                    \"Flight\"\n                                )\n                            ) === f\n                    )\n                    .map(\n                        (\n                            d: RowObject\n                        ): AwardJson => ({\n\n                            type:\n                                \"Day Money\",\n\n                            day:\n                                getValue(\n                                    d,\n                                    \"Day\"\n                                ),\n\n                            place:\n                                getValue(\n                                    d,\n                                    \"Place\"\n                                ),\n\n                            amount:\n                                toNumber(\n                                    getValue(\n                                        d,\n                                        \"Amount\"\n                                    )\n                                ),\n\n                            winner:\n                                getValue(\n                                    d,\n                                    \"Winner\"\n                                ),\n\n                            owner:\n                                getValue(\n                                    d,\n                                    \"Owner\"\n                                )\n\n                        })\n                    );\n\n            flights.push(\n                {\n\n                    flight:\n                        f,\n\n                    total:\n                        flightTotal,\n\n                    teams:\n                        flightTeams,\n\n                    flight_winners:\n                        flightWinners,\n\n                    day_money:\n                        dayMoneyRows\n\n                }\n            );\n\n        }\n    );\n\n    return flights;\n\n}\n\nfunction buildSummary(\n    teams: RowObject[],\n    flights: FlightJson[]\n): SummaryJson {\n\n    let totalBid: number =\n        0;\n\n    teams.forEach(\n        (\n            t: RowObject\n        ) => {\n\n            totalBid =\n                totalBid +\n                toNumber(\n                    getValue(\n                        t,\n                        \"Bid\"\n                    )\n                );\n\n        }\n    );\n\n    let topFlight: number =\n        0;\n\n    let topFlightTotal: number =\n        0;\n\n    flights.forEach(\n        (\n            f: FlightJson\n        ) => {\n\n            if (\n                f.total > topFlightTotal\n            ) {\n\n                topFlightTotal =\n                    f.total;\n\n                topFlight =\n                    f.flight;\n\n            }\n\n        }\n    );\n\n    return {\n\n        flightCount:\n            flights.length,\n\n        teamCount:\n            teams.length,\n\n        avgBid:\n            teams.length > 0\n                ? totalBid / teams.length\n                : 0,\n\n        topFlight:\n            topFlight,\n\n        topFlightTotal:\n            topFlightTotal\n\n    };\n\n}\n\nfunction buildShootout(\n    shootoutRows: RowObject[]\n): ShootoutJson {\n\n    if (\n        shootoutRows.length === 0\n    ) {\n\n        return {\n\n            bonusPool:\n                0,\n\n            firstPlace:\n                0,\n\n            secondPlace:\n                0,\n\n            thirdPlace:\n                0\n\n        };\n\n    }\n\n    const row: RowObject =\n        shootoutRows[0];\n\n    return {\n\n        bonusPool:\n            toNumber(\n                getValue(\n                    row,\n                    \"BonusPool\"\n                )\n            ),\n\n        firstPlace:\n            toNumber(\n                getValue(\n                    row,\n                    \"FirstPlace\"\n                )\n            ),\n\n        secondPlace:\n            toNumber(\n                getValue(\n                    row,\n                    \"SecondPlace\"\n                )\n            ),\n\n        thirdPlace:\n            toNumber(\n                getValue(\n                    row,\n                    \"ThirdPlace\"\n                )\n            )\n\n    };\n\n}\n\nfunction buildDataCheck(\n    flights: FlightJson[]\n): DataCheckJson {\n\n    let sumOfFlightTotals: number =\n        0;\n\n    let sumOfTeamBids: number =\n        0;\n\n    let teamCount: number =\n        0;\n\n    flights.forEach(\n        (\n            f: FlightJson\n        ) => {\n\n            sumOfFlightTotals =\n                sumOfFlightTotals +\n                f.total;\n\n            f.teams.forEach(\n                (\n                    t: TeamJson\n                ) => {\n\n                    sumOfTeamBids =\n                        sumOfTeamBids +\n                        t.bid;\n\n                    teamCount =\n                        teamCount +\n                        1;\n\n                }\n            );\n\n        }\n    );\n\n    return {\n\n        flightCount:\n            flights.length,\n\n        teamCount:\n            teamCount,\n\n        sumOfFlightTotals:\n            sumOfFlightTotals,\n\n        sumOfTeamBids:\n            sumOfTeamBids\n\n    };\n\n}\n\nfunction writeJsToWorksheet(\n  workbook: ExcelScript.Workbook,\n  jsText: string\n): void {\n\n  let outputSheet:\n    ExcelScript.Worksheet | undefined =\n    workbook.getWorksheet(\n      \"JS_Output\"\n    );\n\n  if (!outputSheet) {\n\n    outputSheet =\n      workbook.addWorksheet(\n        \"JS_Output\"\n      );\n\n  }\n\n  const usedRange:\n    ExcelScript.Range | undefined =\n    outputSheet.getUsedRange();\n\n  if (usedRange) {\n\n    usedRange.clear();\n\n  }\n\n  const lines: string[] =\n    jsText.split(\n      \"\\n\"\n    );\n\n  const values: string[][] =\n    lines.map(\n      (\n        line: string\n      ): string[] => [\n          line\n        ]\n    );\n\n  outputSheet\n    .getRangeByIndexes(\n      0,\n      0,\n      values.length,\n      1\n    )\n    .setValues(\n      values\n    );\n\n  outputSheet\n    .getRange(\n      \"C1\"\n    )\n    .setValue(\n      \"JavaScript DATA file generated\"\n    );\n\n  outputSheet\n    .getRange(\n      \"C2\"\n    )\n    .setValue(\n      new Date()\n        .toISOString()\n    );\n\n  outputSheet\n    .getRange(\n      \"C3\"\n    )\n    .setValue(\n      \"Save Column A as data.js\"\n    );\n\n}\n\nfunction getValue(\n    row: RowObject,\n    key: string\n): string {\n\n    if (\n        row[key] !== undefined\n    ) {\n\n        return row[key];\n\n    }\n\n    return \"\";\n\n}\n\nfunction toNumber(\n    value: string\n): number {\n\n    const cleaned: string =\n        String(\n            value || \"\"\n        )\n            .replace(\n                /[$,]/g,\n                \"\"\n            )\n            .trim();\n\n    const parsed: number =\n        Number(\n            cleaned\n        );\n\n    if (\n        isNaN(\n            parsed\n        )\n    ) {\n\n        return 0;\n\n    }\n\n    return parsed;\n\n}","description":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"string\"}}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}